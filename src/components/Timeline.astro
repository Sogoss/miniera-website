---
/* The rail of the programme: one tick per evening, the one on screen marked.
 *
 * In the design files it is the *binario* — vertical on the right on a desktop,
 * a bar across the bottom on a phone, and without the «oggi» divider the two
 * exports had (docs/decisioni.md). Right and not left: the desktop design puts
 * it there and gives the scene a wide right padding to match, so moving it
 * would mean swapping the columns of every scene too.
 *
 * **A tick is a link.** The export writes `<button onClick>`, and that button
 * does what somebody wrote for it and nothing else; `<a href="#serata-81">` is
 * the element for a thing that leads to a place in the document, and it arrives
 * with the address bar, the back button, open-in-new-tab, the announcement a
 * screen reader makes for a link and a focus that moves — none of which is
 * written here. With scripting off it is the whole feature, working: the
 * browser does the jump. That is not the reason it was chosen, it is what
 * choosing the cheaper element happens to give.
 *
 * **A window, not eighty-one ticks.** At about twenty pixels each the archive is
 * sixteen hundred pixels of rail in a column one screen tall. All the ticks are
 * in the markup — they are the programme, and a crawler and Ctrl+F should find
 * them — and the ones outside a window around the current evening are not
 * displayed, which also keeps seventy-odd links out of the tab order. The
 * build centres that window on the evening the programme opens on, so it is
 * right before any script has run; the observer in index.astro moves it.
 *
 * The width of the window lives here and only here. It was going to be a custom
 * property so that CSS could vary it per breakpoint, and that would have meant
 * the same number declared twice — in the stylesheet for the browser and here
 * for the build — which is the drift this repository keeps catching. One
 * constant, published as `data-window` for the script.
 */
import type { Scene } from '../lib/programme.ts';

interface Props {
  scenes: Scene[];
  /** Index of the evening the programme opens on. */
  current: number;
}

const { scenes, current } = Astro.props;

/** How many ticks either side of the current one are shown. */
const WINDOW = 5;

/* How far this tick is from the current one, or nothing at all if it is outside
   the window — which is the one state CSS reads as «do not show this».
   The true distance and not the export's three ranks: the rail is a column on a
   desktop and a bar on a phone, where eleven ticks have never fitted, and a
   distance lets the stylesheet narrow the window by itself. Capped at two, the
   only way to do that would have been a second number in JavaScript, and the
   markup would have been wrong for anyone whose scripts had not run. */
function rank(index: number): string | undefined {
  const away = Math.abs(index - current);
  return away > WINDOW ? undefined : String(away);
}
---

{/* The ticks are the children of the strip, with no list around them.
    A list would be the ordinary way to mark up navigation links, and here it
    announces a lie: eighty-one items of which eleven are shown, because hiding
    the tick leaves its `<li>` behind — empty, in the accessibility tree, and
    still a flex item drawing a gap between things that are not there. Both of
    those are the wrapper, not the window. A `<nav>` of links says the true
    number, because what is hidden is the whole child. */}
<nav class="timeline" data-timeline data-window={WINDOW} aria-label="Le serate">
  <div class="timeline-strip">
    {
      scenes.map((scene, index) => (
        <a
          class="timeline-tick"
          href={`#serata-${scene.number}`}
          data-tick
          data-index={index}
          data-near={rank(index)}
          aria-current={index === current ? 'true' : undefined}
        >
          <span class="tick-mark" aria-hidden="true" />
          <span class="tick-date">{scene.shortDate}</span>
          {/* The date alone names nothing on a list of eighty-one of them.
              Said and not shown: the rail has room for six characters. */}
          <span class="visually-hidden">— {scene.title}</span>
        </a>
      ))
    }
  </div>
</nav>

<style>
  /* Fixed, because the programme scrolls underneath it and this does not.
     `pointer-events` off on the column and on again for the ticks: a fixed box
     over the scroller is hit-tested first, and a wheel over it would look for a
     scrolling ancestor of its own — finding the document, which is one screen
     tall and does not move. The result is a strip where the programme will not
     scroll. Off, the wheel reaches the scene underneath; the ticks themselves
     stay clickable and stay that strip, which is as narrow as they are. */
  .timeline {
    position: fixed;
    z-index: 55;
    top: 0;
    right: 0;
    box-sizing: border-box;
    width: var(--timeline-width);
    height: var(--scene-height);
    display: grid;
    align-content: center;
    padding: var(--space-5) var(--space-4);
    overflow: hidden;
    pointer-events: none;
  }

  /* `gap` is safe here because the ticks are the flex items themselves: a child
     with `display: none` is not a flex item at all, so no gap is drawn beside
     it. It was not safe while each tick sat inside an `<li>` — the wrapper
     stayed, empty and zero tall, and a gap is drawn between flex items whether
     or not they contain anything. With eighty-one evenings that was seventy
     gaps of nothing, a thousand pixels of empty rail that pushed the eleven
     visible ticks off the bottom of the screen. */
  .timeline-strip {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  /* The rail the ticks sit on, faded at both ends so the window does not read
     as a list that has been cut. */
  .timeline-strip::before {
    content: '';
    position: absolute;
    top: 4px;
    bottom: 4px;
    left: 0;
    width: var(--border-width-hairline);
    background: linear-gradient(
      to bottom,
      transparent,
      var(--border-hairline) 12%,
      var(--border-hairline) 88%,
      transparent
    );
  }

  /* Every evening is on the rail. What the window decides is which of them
     carry their date: `[data-near]` is the labelled few around the current one,
     and everything else is a bare mark — the archive, present and reachable in
     one press.

     It used to be `display: none` out there, and with eighty-one evenings that
     made the rail a «previous / next»: from the eleven on screen there was no
     way to reach the twelfth except scrolling seventy screens past it. The
     export has the same limit and never met it, because its design files hold
     six evenings. */
  .timeline-tick {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-block: var(--space-1);
    pointer-events: auto;
    color: var(--tick-far);
    font: var(--type-mono);
    font-size: var(--text-2xs);
    text-align: right;
    text-decoration: none;
    white-space: nowrap;
    transition:
      color var(--dur-slow) var(--ease-out),
      font-size var(--dur-base) var(--ease-out);
  }

  /* A bare mark: no date, and a pitch small enough that the whole archive fits
     a column one screen tall — eighty-one of these at six pixels come to about
     five hundred, next to three hundred for the eleven that are labelled.
     Spacing carried by the tick and not by a `gap` on the strip, because the
     two ranks need different spacing and a gap is one number for everybody.

     And carried as **padding**, which is inside the box and takes the click,
     rather than as margin, which is outside it and does not: written as margin
     the pitch was the same six pixels and the target was the two the mark is
     tall, which is a link nobody can hit on purpose. */
  .timeline-tick:not([data-near]) {
    margin-block: 0;
    padding-block: 2px;
  }

  .timeline-tick:not([data-near]) .tick-date {
    display: none;
  }

  .timeline-tick[data-near='1'] {
    color: var(--tick-near);
  }

  /* Last of the three, and equal in specificity to the one above: the current
     tick has to win on the order of these rules.

     The accent is on the mark and never on the date. What the cycles guarantee
     is 3:1 against the ground — the threshold for a border or a mark — while a
     word wants 4.5:1, and at 15px three of the five tuned cycles do not get
     there: the orange is at 4.35, the rose at 3.92, the purple at 3.88. It is
     the same decision Modal.astro writes out for the link inside the panel —
     the colour goes where 3:1 is the right bar, and the word stays at the
     contrast of ordinary text. The size and the weight are what say «this
     one». */
  .timeline-tick[data-near='0'] {
    color: var(--text-primary);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
  }

  .tick-date {
    flex: 1;
  }

  .tick-mark {
    flex: none;
    width: 9px;
    height: 2px;
    background: currentColor;
    transition: width var(--dur-slow) var(--ease-out);
  }

  .timeline-tick[data-near='1'] .tick-mark {
    width: 16px;
  }

  .timeline-tick[data-near='0'] .tick-mark {
    width: 26px;
    background: var(--accent);
  }

  /* A bar across the bottom, as in the mobile design: a row of pills with the
     current one filled.
     Here the box does take pointer events — it has a ground and an edge and
     reads as a bar, so a finger landing on it is on a control and not on the
     evening behind it. */
  @media (max-width: 900px) {
    .timeline {
      top: auto;
      right: var(--space-3);
      bottom: var(--space-3);
      left: var(--space-3);
      width: auto;
      height: auto;
      /* One step and not one half-step, and the reason is the focus ring: the
         box is clipped, so a ring drawn `outline-offset` outside a tick is
         drawn outside the clip and nothing of it shows. The padding has to be
         at least the offset plus the width of the ring. `--timeline-bar`
         is the sum of exactly these parts, so a scene keeps its text clear of
         whatever this comes to. */
      padding: var(--space-2);
      background: var(--veil-bar);
      /* Both spellings: Safari only dropped the prefix at 18, and this
         project's floor is 15.4. Two different properties, not the double
         declaration of rule 4 — nothing here collapses into nothing. */
      -webkit-backdrop-filter: blur(16px);
      backdrop-filter: blur(16px);
      border: var(--border-width-hairline) solid var(--border-hairline);
      border-radius: var(--radius-pill);
      pointer-events: auto;
    }

    /* The bar scrolls, and the exception is written into the selector.
       `checkSingleScroller` asks a page to have one scrolling box, and the
       reason it gives is nesting: two of them one inside the other and neither
       a keyboard nor a screen reader can tell which the arrow keys are driving.
       This one is neither nested nor vertical — it is fixed, it sits outside
       the programme, and it moves along the other axis, so it takes no gesture
       the scroller wanted. From the CSS none of that is visible in
       `.timeline-strip`, so the rule says `[data-timeline]` out loud and the
       guard exempts a box that scrolls **horizontally** and carries that
       attribute. `overflow-y: hidden` is part of the claim, not tidiness. */
    .timeline[data-timeline] {
      overflow-x: auto;
      overflow-y: hidden;
      scrollbar-width: none;
    }

    .timeline[data-timeline]::-webkit-scrollbar {
      width: 0;
      height: 0;
    }

    /* From the start and not centred: a row that overflows a box is aligned to
       its start whatever `justify-content` says — the engines refuse to lose
       content off the leading edge — and here the strip is meant to overflow,
       because all eighty-one evenings are in it. Where the reader is looking is
       set by scrolling the bar, which the observer does. */
    .timeline-strip {
      flex-direction: row;
      justify-content: flex-start;
      width: max-content;
    }

    /* Every evening keeps its date here: on a phone the bar scrolls, so there
       is no reason to spend a rank on hiding it, and a bare two-pixel mark is
       not something a finger can aim at. That is the whole reason this bar
       scrolls and the rail does not. */
    .timeline-tick:not([data-near]) .tick-date {
      display: inline;
    }

    .timeline-tick {
      /* The touch target, from the token the bar's own height is summed from:
         raised here alone it would grow the bar under a scene that had already
         reserved the old height, and the note would go under the pills. */
      min-height: var(--timeline-tick-height);
      margin-block: 0;
      margin-inline: var(--space-1);
      padding: 0 var(--space-2);
      border-radius: var(--radius-pill);
      color: var(--tick-near);
      font-size: var(--text-2xs);
      letter-spacing: var(--tracking-caps);
      text-transform: uppercase;
      transition:
        background var(--dur-base) var(--ease-out),
        color var(--dur-base) var(--ease-out);
    }

    .timeline-tick[data-near='0'] {
      background: var(--accent);
      color: var(--text-on-accent);
      font-size: var(--text-2xs);
    }

    .tick-mark {
      display: none;
    }
  }

  /* Fine on the ground of a scene, and unreadable on the filled pill of the
     current tick on a phone — where the ring would be the accent on the
     accent. Offset outwards, which is what the rest of the site does. */
  .timeline-tick:focus-visible {
    outline: var(--border-width-strong) solid var(--focus-ring);
    outline-offset: var(--space-1);
  }
</style>

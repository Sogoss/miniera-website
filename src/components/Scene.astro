---
/* One evening, as one screen of the scroller.
 *
 * Everything it shows has already been decided by the domain: the state, the
 * note under the buttons, the two date strings, the roles of the guests. This
 * component chooses none of it — it lays it out. That is what keeps the time
 * zone in one place and the scroller free of `new Date()`.
 *
 * Four attributes are not decoration and have to survive any redesign of this
 * file: `data-number` names the evening, `data-state` says which side of today
 * it falls on, `data-open` marks the one the programme opens on, and
 * `data-cycle` is what paints the accent. The first three are what
 * test/build/published-dates.test.ts reads out of dist/ to prove the build in
 * UTC still publishes Italian hours; CLAUDE.md promised the scroller would
 * carry them, and this is that promise. `data-label` carries the short date the
 * Timeline of PR 8 will put on its ticks — the export keeps it on the section
 * too, as `data-screen-label`.
 *
 * The scene is not itself scrollable, which is a departure from the export:
 * a scrollable section inside a scrollable scroller makes it ambiguous which
 * one the arrow keys are talking to, for a keyboard and for a screen reader
 * alike — docs/vincoli-tecnici.md. Long text is handled by type that shrinks
 * and, on a short screen, by clamping the description to a few lines.
 */
import { Image } from 'astro:assets';
import Button from './Button.astro';
import GuestRow from './GuestRow.astro';
import Label from './Label.astro';
import { type EventState, stateOf } from '../lib/events.ts';
import type { Scene } from '../lib/programme.ts';
import { fullAddress } from '../lib/venues.ts';

interface Props {
  scene: Scene;
  /** The one the programme opens on. */
  open?: boolean;
  /** The only image loaded up front is the one a reader lands on. */
  eager?: boolean;
}

const { scene, open = false, eager = false } = Astro.props;

const state: EventState = stateOf(scene, scene.past);

/* Shown only when it says something the note does not: an upcoming evening is
   already announced by «Ingresso libero, posti limitati» underneath. */
const STATE_LABEL: Partial<Record<EventState, string>> = {
  past: 'già svolta',
  cancelled: 'annullata',
};

const stateLabel = STATE_LABEL[state];
const titleId = `titolo-${scene.number}`;

/* Written once because it is published twice — the button that opens the panel
   and the link that stands in for it with no scripting are the same offer, and
   two literals would be one edit away from disagreeing. */
const BOOKING_LABEL = 'Prenota il posto';
---

<section
  id={`serata-${scene.number}`}
  class="scene"
  data-scene
  data-number={scene.number}
  data-state={state}
  data-cycle={scene.cycle.number}
  data-label={scene.shortDate}
  data-open={open ? 'true' : undefined}
  aria-labelledby={titleId}
>
  <div class="scene-text">
    <div class="scene-heading">
      <Label>Ciclo {scene.cycle.name}</Label>
      <span class="scene-format">{scene.format}</span>
      {stateLabel && <span class="scene-state">{stateLabel}</span>}
    </div>

    <h2 class="scene-title" id={titleId}>{scene.title}</h2>
    {scene.kicker && <p class="scene-kicker">{scene.kicker}</p>}
    <p class="scene-description">{scene.description}</p>

    {
      scene.speakers.length > 0 && (
        <div class="scene-guests">
          {scene.speakers.map((speaker) => (
            <GuestRow name={speaker.name} role={speaker.role} size={20}>
              {speaker.photo && (
                <Image
                  slot="portrait"
                  src={speaker.photo}
                  alt=""
                  width={112}
                  height={112}
                  loading="lazy"
                  decoding="async"
                />
              )}
            </GuestRow>
          ))}
        </div>
      )
    }

    <div class="scene-meta">
      <p class="scene-fact">
        <svg class="scene-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <rect x="3" y="5" width="18" height="16"></rect>
          <path d="M3 10h18M8 3v4M16 3v4"></path>
        </svg>
        <span class="scene-when">{scene.longDate}</span>
      </p>
      <p class="scene-fact">
        <svg class="scene-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11z"></path>
          <circle cx="12" cy="10" r="2.6"></circle>
        </svg>
        <span>{fullAddress(scene.venue)}</span>
      </p>
      {
        scene.attendance !== undefined && (
          <p class="scene-fact scene-attendance">
            <svg class="scene-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <circle cx="9" cy="8" r="3.2" />
              <path d="M3 20c0-3.3 2.7-5.4 6-5.4s6 2.1 6 5.4" />
              <path d="M16 5.4a3.2 3.2 0 0 1 0 6M17.5 14.9c2.1.7 3.5 2.4 3.5 5.1" />
            </svg>
            <span>{scene.attendance} persone in sala</span>
          </p>
        )
      }
    </div>

    {/* One button, whatever the evening has to offer.
        A past evening with recordings had one button per recording, and on a
        390×800 screen the second one fell under the bottom edge — with the
        scene deliberately not scrollable, that is content nobody can reach. So
        the buttons collapse into one that opens the modal.

        The links themselves stay in the markup as real links, hidden only once
        the script has run: the modal is filled by cloning this list, so there
        is one source, and with scripting off the list is simply visible. */}
    <div class="scene-actions">
      {
        scene.materials.length > 0 && (
          <Fragment>
            <Button class="only-js" data-modal-from={`materials-${scene.number}`} data-modal-title={scene.title}>
              Rivedi la serata
            </Button>
            <ul class="scene-materials no-js-only" id={`materials-${scene.number}`}>
              {scene.materials.map((material) => (
                <li>
                  <a href={material.url} target="_blank" rel="noopener">
                    <svg class="material-play" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                      <circle cx="12" cy="12" r="9.2" />
                      <path d="M10 8.6l6 3.4-6 3.4z" fill="currentColor" stroke="none" />
                    </svg>
                    <span class="material-label">{material.label}</span>
                    {/* Said, not drawn: an arrow means «this opens elsewhere» to
                        someone who can see it and nothing at all to someone who
                        cannot. */}
                    <span class="visually-hidden">— si apre in una nuova scheda</span>
                    <svg class="material-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <path d="M5 12h13M12.5 6l6 6-6 6" />
                    </svg>
                  </a>
                </li>
              ))}
            </ul>
          </Fragment>
        )
      }

      {/* The booking, in the two forms one page can carry: the button that opens
          the panel, and the link that is left when no script runs. The CSS shows
          whichever is going to work — the same `only-js` / `no-js-only` pair the
          recordings above use — so nothing flashes and nothing is dead.

          The panel is per evening and no longer one shared by the whole
          programme, because the message it sends names the evening: one
          `<template>` for all of them could only carry a link that names none.
          Filling it from a `data-` attribute in the script was the other way,
          and it is the modal building content out of data instead of cloning it
          — an address written by a script is an address that does not exist for
          whoever does not run one.

          In a `<template>` because, unlike the recordings, this text has no
          place in the page until it is asked for: what a reader with no
          scripting loses is the explanation, not the action — the link leaves
          with the message already written. */}
      {
        state === 'upcoming' && (
          <Fragment>
            <Button
              class="only-js"
              data-modal-from={`booking-${scene.number}`}
              data-modal-title={scene.title}
            >
              {BOOKING_LABEL}
            </Button>

            <Button class="no-js-only" href={scene.bookingUrl} target="_blank" rel="noopener">
              {BOOKING_LABEL}
              <span class="visually-hidden">— si apre in una nuova scheda</span>
            </Button>

            <template id={`booking-${scene.number}`}>
              <p>
                La sala ha sessanta posti. Per tenerne uno si scrive
                all'organizzatore con il proprio nome e quante persone siete: la
                risposta arriva in serata.
              </p>
              <p>Se non si prenota si può venire lo stesso, ma il posto non è garantito.</p>
              <p>
                <a href={scene.bookingUrl} target="_blank" rel="noopener">
                  Scrivi su WhatsApp
                  <span class="visually-hidden">— si apre in una nuova scheda</span>
                </a>
              </p>
            </template>
          </Fragment>
        )
      }

      <p class="scene-note">{scene.note}</p>
    </div>
  </div>

  {/* The band, and not only what goes in it, depends on there being a picture:
      on a phone `.scene-photo` is the grid row that takes what is left, with a
      floor of a quarter of the screen, so an evening with no picture published
      an empty quarter of a screen above its own title. Most evenings of the
      archive have no picture yet. */}
  {
    scene.photo && (
      <div class="scene-photo">
        <div class="scene-photo-frame">
          <div class="scene-photo-image">
            {/* Empty alt on purpose: the picture accompanies what the text beside it
                already says, so a screen reader announcing it would read the
                evening twice. */}
            <Image
              src={scene.photo}
              alt=""
              widths={[400, 800, 1200]}
              sizes="(max-width: 900px) 60vw, 32vw"
              loading={eager ? 'eager' : 'lazy'}
              decoding="async"
            />
          </div>
        </div>
      </div>
    )
  }
</section>

<style>
  .scene {
    height: var(--scene-height);
    box-sizing: border-box;
    scroll-snap-align: start;

    /* The two halves of «81 evenings in one document stay fast»: the browser
       skips style, layout and paint of what is off screen, and the declared
       intrinsic height keeps the snap positions — and the opening jump —
       exactly where they belong. Below Safari 18 the first line is ignored and
       nothing else changes. */
    content-visibility: auto;
    contain-intrinsic-size: auto var(--scene-height);

    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(24px, 4vw, 64px);
    align-content: safe center;

    /* The right side is not the left: the Timeline's rail stands there, fixed
       over the scroller, and text running under it is the kind of defect that
       only shows up on the evening with the longest description. The measure is
       the rail's own, from the tokens, so the two cannot drift. */
    padding: clamp(88px, 12vh, 140px) calc(var(--timeline-width) + var(--space-4))
      clamp(48px, 8vh, 88px) clamp(24px, 6vw, 104px);
    border-bottom: var(--border-width-hairline) solid var(--border-hairline);
  }

  .scene-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(8px, 2vh, 20px);
    min-width: 0;
  }

  .scene-heading {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .scene-format,
  .scene-state {
    font: var(--type-mono);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }

  .scene-format {
    color: var(--text-secondary);
  }

  .scene-state {
    color: var(--text-muted);
  }

  /* Fluid down to a phone and up to a wide desktop, bounded by both the width
     and the height: a title that scales on width alone eats the screen when the
     window is short and wide. */
  .scene-title {
    margin: 0;
    font-size: clamp(28px, min(4.6vw, 7.2vh), 72px);
    line-height: 0.98;
    text-wrap: pretty;
  }

  .scene-kicker {
    margin: 0;
    font: var(--type-small);
    color: var(--text-secondary);
  }

  .scene-description {
    margin: 0;
    max-width: var(--max-content);
    font: var(--type-body);
    font-size: clamp(15px, 1.8vh, 21px);
    color: var(--text-secondary);
    text-wrap: pretty;
  }

  .scene-guests {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .scene-meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-3);
    border-top: var(--border-width-hairline) solid var(--border-hairline);
  }

  .scene-fact {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin: 0;
    max-width: none;
    font: var(--type-body);
    color: var(--text-primary);
  }

  .scene-when {
    font-weight: var(--weight-semibold);
  }

  /* An evening that was called off, struck through on the two facts the
     cancellation takes away: what it was, and when it was going to be. The
     place stays — the room is still there — and so does the description, which
     is where an editor writes what happened.

     Hung on `data-state` and not on a class of its own: the state is decided by
     `stateOf` in the domain, once, and every part of the site asks the same
     question of the same attribute. There is one place to write this because
     there is one template — the route `/80` is this same scene, opened on it —
     and a second copy would be two declarations at equal specificity decided by
     the order of two stylesheets, which is rule 12 in another costume.

     Said in words as well as drawn: `line-through` is not announced by a screen
     reader, so the label above the title reads «annullata» and the note below
     reads «Serata annullata». Neither of those is this rule's job, and both are
     already there — this is the half a reader sees at a glance. */
  .scene[data-state='cancelled'] .scene-title,
  .scene[data-state='cancelled'] .scene-when {
    text-decoration: line-through;
    text-decoration-thickness: var(--border-width-hairline);
  }

  .scene-icon {
    flex: none;
    width: 18px;
    height: 18px;
    color: var(--accent);
  }

  .scene-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
  }

  .scene-note {
    margin: 0;
    font: var(--type-small);
    color: var(--text-muted);
  }

  /* These are the rows the modal shows, and the same markup is what a reader
     with no scripting gets in the scene — the modal clones it, and the scoped
     styles come along with it, so this is written once.

     Made to look pressable rather than to look like text: a play mark on the
     left, the label, an arrow on the right, a surface and an edge. The accent
     goes on the edge and on the play mark and never on the words, which is
     where the 3:1 the cycles guarantee is the right threshold. */
  .scene-materials {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    width: 100%;
    max-width: 34rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .scene-materials a {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    background: var(--surface-sunken);
    border: var(--border-width-hairline) solid var(--border-hairline);
    border-left: var(--border-width-accent) solid var(--accent);
    border-radius: var(--radius-md);
    color: var(--text-primary);
    font: var(--type-body);
    font-weight: var(--weight-semibold);
    text-decoration: none;
    transition:
      transform var(--dur-fast) var(--ease-out),
      background var(--dur-fast) var(--ease-out);
  }

  .scene-materials a:hover {
    background: var(--surface-page);
  }

  /* The same two pixels down as a Button: the site has one gesture for «this
     was pressed» and it is worth being the same everywhere. */
  .scene-materials a:active {
    transform: translateY(2px);
  }

  .material-play {
    flex: none;
    width: 26px;
    height: 26px;
    color: var(--accent);
  }

  .material-label {
    flex: 1;
    min-width: 0;
  }

  .material-arrow {
    flex: none;
    width: 18px;
    height: 18px;
    color: var(--text-muted);
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .scene-materials a:hover .material-arrow {
    transform: translateX(3px);
    color: var(--text-primary);
  }

  .scene-photo {
    position: relative;
    min-height: 0;
  }

  /* The design turns the picture on its corner and rounds it into a capsule; the
     inner counter-rotation keeps the picture upright inside the tilted frame. */
  .scene-photo-frame {
    position: absolute;
    top: 50%;
    left: 50%;
    height: 88%;
    aspect-ratio: 4 / 5;
    transform: translate(-50%, -50%) rotate(45deg) scale(0.96);
    border-radius: var(--radius-pill);
    overflow: hidden;
  }

  .scene-photo-image {
    width: 100%;
    height: 100%;
    transform: rotate(-45deg) scale(1.5);
  }

  .scene-photo-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* One column, the picture above the text — and the text still ranged left,
     which is where this parts company with the mobile design.

     The poster takes what is left rather than a fixed share of the viewport:
     `30vh` was the design's, and on a 390×800 screen it claimed 240px while the
     text still needed all of its own — which is how the buttons ended up under
     the bottom edge. As a grid row of `1fr` next to a text row of `auto`, the
     text asks first and the picture gets the remainder. */
  @media (max-width: 900px) {
    .scene {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: minmax(0, 1fr) auto;
      align-content: stretch;
      gap: clamp(12px, 2.5vh, 28px);

      /* The rail is a bar across the bottom here, so what it took from the
         right side above it takes from underneath. Its height is a token for
         the same reason. */
      padding: clamp(64px, 9vh, 96px) var(--gutter-page)
        calc(var(--timeline-bar) + var(--space-2));
    }

    .scene-photo {
      order: -1;
      min-height: 0;
    }

    /* The tilted capsule is the brand's, not a decoration to drop when it is
       inconvenient — so on a phone it keeps the shape and gets more room
       instead.

       The height is what the geometry allows: a rectangle turned 45° takes up
       (w + h) / √2 in *both* directions, so in a band 342 wide the frame can be
       at most about 200 tall before its corners run past the edges — and there
       is nothing clipping them. 78% of a band that is itself at least a quarter
       of the screen keeps it inside and keeps it big enough to read as a
       picture. */
    .scene-photo {
      min-height: 26vh;
    }

    .scene-photo-frame {
      height: 78%;
    }
  }

  /* What gives way as the screen gets shorter, in order.
   *
   * Nothing here is lost to a reader: from PR 9 every evening is also a page of
   * its own, with all of it. What a scene must keep is what makes it useful at
   * a glance and actionable — the title, the date, the place, the buttons and
   * the note. So the description goes first (it is the longest, and the one
   * thing repeated in full elsewhere), then the picture, then the attendance.
   *
   * Clipped, never scrollable: a scrollable scene inside a scrollable scroller
   * is the thing the arrow keys cannot tell apart.
   *
   * Two sets of thresholds, because the two layouts do not run out of room at
   * the same height: stacked, the picture sits above the text and eats into it,
   * so the squeeze starts early; side by side, the text has its own column and
   * a laptop at 1440×900 has room to spare — clamping there would cut a
   * description that fits. */
  @media (max-width: 900px) and (max-height: 900px) {
    .scene-description {
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
  }

  @media (max-width: 900px) and (max-height: 780px) {
    .scene-description {
      -webkit-line-clamp: 2;
    }
  }

  @media (max-width: 900px) and (max-height: 680px) {
    .scene-description {
      display: none;
    }
  }

  @media (max-width: 900px) and (max-height: 620px) {
    .scene-photo {
      display: none;
    }
  }

  @media (max-width: 900px) and (max-height: 560px) {
    .scene-attendance {
      display: none;
    }
  }

  @media (min-width: 901px) and (max-height: 800px) {
    .scene-description {
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
  }

  @media (min-width: 901px) and (max-height: 640px) {
    .scene-description {
      -webkit-line-clamp: 2;
    }

    .scene-attendance {
      display: none;
    }
  }
</style>

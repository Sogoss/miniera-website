---
/* The full-width band of accent with the name across it.
 *
 * The default text is the signature in full — «MINIERA CULTURALE IN PERIFERIA»
 * — and not the export's «MINIERA CULTURALE», which is the forbidden short
 * variant written in another typeface. Neither of the two design screens uses
 * this band, so there is no layout the longer string can break, and the one
 * obvious use of the component is now the correct one.
 *
 * It carries `data-brand`, so rule 7's published-page guard reads its text like
 * any other mark. That was not the first decision here: the band was left
 * unmarked on the grounds that it is a typographic band and not the mark, and
 * that a band reading «GIOVEDÌ SERA» is a legitimate thing to want. What that
 * left behind was a free-form `text` prop able to publish the short mark on
 * every page carrying a footer, with neither rule-7 guard able to see it — one
 * keys on this attribute, the other reads only Brand.astro. A band with a
 * different text is a thing somebody can still write; it is just not this
 * component, whose whole default is the signature.
 */
import type { HTMLAttributes } from 'astro/types';

/* `style` composed rather than spread — see Brand.astro: written twice, the
   caller's copy is the one a browser throws away. */
interface Props extends Omit<HTMLAttributes<'div'>, 'style'> {
  text?: string;
  /** In px, like the export: the padding scales from it. */
  size?: number;
  style?: string;
}

const {
  text = 'MINIERA CULTURALE IN PERIFERIA',
  size = 34,
  class: className,
  style,
  ...rest
} = Astro.props;

const inlineStyle = [`--band-size: ${size}px`, style].filter(Boolean).join('; ');
---

<div class:list={['signature-band', className]} data-brand style={inlineStyle} {...rest}>
  {text}
</div>

<style>
  /* Bottom padding heavier than the top, as drawn: the capitals of Archivo
     Black sit high in the line box, and equal padding reads as top-heavy. */
  .signature-band {
    --band-size: 34px;

    width: 100%;
    padding: calc(var(--band-size) * 0.24) 0 calc(var(--band-size) * 0.3);
    background: var(--accent);
    color: var(--text-on-accent);
    font-family: var(--font-display);
    font-weight: var(--weight-black);
    font-size: var(--band-size);
    line-height: 1;
    letter-spacing: var(--tracking-banner);
    text-align: center;
  }
</style>

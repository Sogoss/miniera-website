---
/* The small uppercase label of the design: the cycle of an evening, the format,
 * anything that names a thing rather than saying something about it.
 *
 * The three tones are the export's, with the colours taken one step up into the
 * semantic tokens: `filled` was `--cream-100` on `--blue-700`, which is
 * `--surface-invert` on `--text-on-invert` — the same two colours today, and
 * still the right pair on the paper theme, where both flip.
 */
import type { HTMLAttributes } from 'astro/types';

export type LabelTone = 'accent' | 'outline' | 'filled';

interface Props extends HTMLAttributes<'span'> {
  tone?: LabelTone;
}

const { tone = 'accent', class: className, ...rest } = Astro.props;
---

<span class:list={['label', className]} data-tone={tone} {...rest}>
  <slot />
</span>

<style>
  .label {
    display: inline-block;
    padding: 6px 10px;
    font: var(--type-label);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }

  .label[data-tone='accent'] {
    background: var(--accent);
    color: var(--text-on-accent);
  }

  /* An inset shadow and not a border: the outline has to sit on the same
     footprint as the other two, and a border would grow the label by a pixel
     on each side wherever the three are shown in a row. */
  .label[data-tone='outline'] {
    color: var(--text-primary);
    box-shadow: inset 0 0 0 var(--border-width-hairline) var(--border-hairline);
  }

  .label[data-tone='filled'] {
    background: var(--surface-invert);
    color: var(--text-on-invert);
  }
</style>

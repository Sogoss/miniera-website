---
/* The document every page is written inside.
 *
 * What it owns is what no page should have to remember: the language, the
 * charset and the viewport, the favicon, the meta and the Open Graph tags, the
 * base stylesheet, the skip link — and the two components that have to travel
 * with every page because what they declare only works inside the document that
 * carries it: `CycleAccents` for the `[data-cycle]` rules and `ClipShapes` for
 * the `clip-path: url(#…)` references. Both are guarded: a page that used one
 * without carrying it would not fail, it would publish the wrong colour or an
 * unclipped photo.
 *
 * `og:url` and `og:image` appear only once `site` is set in astro.config.mjs.
 * The domain has not been bought yet — PR 13 — and a relative URL in an Open
 * Graph tag is not resolved by WhatsApp or Facebook: it would look right in the
 * markup and produce a preview with no picture. A test asks for them as soon as
 * `site` is there, so PR 13 does not have to remember either.
 */
import '../styles/global.css';
import ClipShapes from '../components/ClipShapes.astro';
import CycleAccents from '../components/CycleAccents.astro';

interface Props {
  /** The <title>, and the title of every preview. */
  title: string;
  description?: string;
  /** A path from the site root — `/foto/81.jpg` — for the social preview. */
  image?: string;
  /** Where the skip link lands, which is also the id of <main>. */
  mainId?: string;
  skipLabel?: string;
}

const SITE_NAME = 'La Miniera Culturale in Periferia';

/* The association's own words, from the design, with the accents put back:
   the export writes «e un'associazione» and «giovedi». */
const DEFAULT_DESCRIPTION =
  'Un locale che nessuno usava, aperto il giovedì sera: incontri, proiezioni, presentazioni. Nessun abbonamento, nessuna prenotazione, si entra e si siede.';

const {
  title,
  description = DEFAULT_DESCRIPTION,
  image,
  mainId = 'programma',
  skipLabel = 'Salta al programma',
} = Astro.props;

/* Absolute, or absent. Astro.site is undefined until PR 13 sets it. */
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const preview = Astro.site && image ? new URL(image, Astro.site).href : undefined;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    {canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {preview && <meta property="og:image" content={preview} />}

    <meta name="twitter:card" content={preview ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {preview && <meta name="twitter:image" content={preview} />}

    <CycleAccents />
  </head>

  <body>
    <a class="skip-link" href={`#${mainId}`}>{skipLabel}</a>
    <ClipShapes />

    <!-- tabindex="-1" so that the jump moves the focus and not only the
         scroll: without it several browsers scroll the page and leave the
         keyboard where it was, which is the whole thing the link is for. -->
    <main id={mainId} tabindex="-1">
      <slot />
    </main>
  </body>
</html>

<style>
  /* Off the top of the page until it is focused, and then in front of
     everything. Not `:focus-visible`: this link exists for a keyboard, and it
     has to appear the moment it takes focus, however it got it. */
  .skip-link {
    position: absolute;
    z-index: 10;
    top: var(--space-3);
    left: var(--space-3);
    padding: var(--space-2) var(--space-4);
    background: var(--surface-accent);
    color: var(--text-on-accent);
    font: var(--type-label);
    text-decoration: none;
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-lift);
    transform: translateY(calc(-100% - var(--space-4)));
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  /* The jump target must not draw a focus ring around the whole page: the
     outline belongs to what the reader operates, and <main> is not that. */
  main:focus {
    outline: none;
  }
</style>

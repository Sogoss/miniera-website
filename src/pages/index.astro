---
// TEMPORARY PAGE — it only proves the chain holds up: importing the tokens,
// resolving the font files, loading the collections and the references between
// them, and now the domain that turns them into what a reader sees. The real
// scroller replaces it.
//
// It is also the only published evidence the build layer has: the strings
// below are what test/build/published-dates.test.ts reads out of dist/, built
// under TZ=UTC the way Cloudflare builds it. That layer finds an evening by
// its `data-number`, reads its state off `data-state` and finds the opening
// scene by `data-open` — three attributes the scroller of PR 7 has to carry as
// well, and the only three. Anchoring the proof to the decoration of a page
// meant to be thrown away would take it down with the page; anchoring the state
// to the Italian words would have it read an evening's description looking for
// «in programma».
import '../styles/global.css';
import { loadProgramme } from '../lib/programme.ts';
import { stateOf, type EventState } from '../lib/events.ts';

/** The state in English, like every attribute value; the label under it is
 *  what the reader sees. Which state an evening is in is the domain's answer,
 *  not this page's — src/lib/events.ts, where it has a test. */
const LABEL: Record<EventState, string> = {
  cancelled: 'annullata',
  past: 'già svolta',
  upcoming: 'in programma',
};

const { scenes, nextIndex } = await loadProgramme();
---

<html lang="it">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>La Miniera Culturale in Periferia</title>
  </head>
  <body>
    <main style="padding: var(--space-7) var(--gutter-page); max-width: var(--max-page); margin: 0 auto;">
      <h1>Verifica della catena</h1>
      <p style="color: var(--text-secondary);">
        Token, caratteri self-hostati, collection e utilità di dominio. Nessun
        pezzo del sito vero.
      </p>

      {
        scenes.map((scene, index) => (
          <article data-number={scene.number} data-state={stateOf(scene, scene.past)} data-open={index === nextIndex ? 'true' : undefined} data-cycle={scene.cycle.number} style="border-top: 4px solid var(--accent); padding: var(--space-5) 0; margin-top: var(--space-5);">
            <span style="font: var(--type-mono); text-transform: uppercase; letter-spacing: var(--tracking-caps); color: var(--accent);">
              #{scene.number} · Ciclo {scene.cycle.name} · {scene.format} ·{' '}
              {LABEL[stateOf(scene, scene.past)]}
              {index === nextIndex && ' · apertura dello scroller'}
            </span>
            <h2 style="margin: var(--space-2) 0;">{scene.title}</h2>
            <p style="font: var(--type-mono); color: var(--text-muted);">
              {scene.longDate} — tacca: {scene.shortDate}
            </p>
            <p style="color: var(--text-secondary);">{scene.description}</p>
            <p style="font: var(--type-small); color: var(--text-secondary);">
              {scene.note} — {scene.venue.name}, {scene.venue.address},{' '}
              {scene.venue.city}
            </p>
            <ul style="font: var(--type-small); color: var(--text-secondary);">
              {scene.speakers.map((speaker) => (
                <li>{speaker.name} — {speaker.role}</li>
              ))}
            </ul>
            {scene.materials.length > 0 && (
              <ul style="font: var(--type-small); color: var(--text-secondary);">
                {scene.materials.map((material) => (
                  <li><a href={material.url}>{material.label}</a></li>
                ))}
              </ul>
            )}
          </article>
        ))
      }
    </main>
  </body>
</html>

---
/* The programme, at the root: the scroller opened on the first evening still to
 * come.
 *
 * The same document `/81` serves, and the difference is the head and one line
 * of the body. This route belongs to the site rather than to an evening: its
 * title and its description are the association's, and its `<h1>` says what the
 * page is instead of naming a particular Thursday. That matters for exactly one
 * reason — eighty-one routes publishing the same body would otherwise be
 * eighty-one documents a crawler cannot tell apart.
 *
 * And it is the one address that does not age. `/81` is the eighty-first
 * evening for ever; this is «the next one», whenever it is read. The script
 * inside the programme leaves it alone until the reader scrolls, for that
 * reason: a bookmark on the root has to keep meaning the next evening.
 */
import Base from '../layouts/Base.astro';
import Programme from '../components/Programme.astro';
import { loadProgramme } from '../lib/programme.ts';

const { scenes, nextIndex } = await loadProgramme();

/* The accent the document opens on, for everything that is not inside a scene.
   The observer moves it as the reader scrolls; this is what a reader with no
   scripting gets, and it is the colour of the evening they are looking at. */
const openingCycle = scenes[nextIndex]?.cycle.number;
---

<Base title="Il programma — La Miniera Culturale in Periferia" cycle={openingCycle}>
  {/* The design has no room for a title of the page: the evenings carry the
      headings. It is said rather than shown — for a screen reader arriving at
      the top, and for a crawler reading a page whose <h2>s would otherwise
      hang off nothing. */}
  <h1 class="visually-hidden">Il programma della Miniera Culturale in Periferia</h1>

  <Programme scenes={scenes} openIndex={nextIndex} />
</Base>

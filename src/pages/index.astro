---
// TEMPORARY PAGE — it only proves the chain holds up: importing the tokens,
// resolving the font files, loading the collections and the references between
// them. The real scroller replaces it.
import '../styles/global.css';
import { getCollection, getEntry } from 'astro:content';

const events = (await getCollection('eventi')).sort(
  (a, b) => a.data.number - b.data.number,
);

const rows = await Promise.all(
  events.map(async (event) => {
    const cycle = await getEntry(event.data.cycle);
    const venue = await getEntry(event.data.venue);
    const speakers = await Promise.all(
      event.data.speakers.map(async (s) => {
        const person = await getEntry(s.person);
        return { name: person?.data.name, role: s.role ?? person?.data.role };
      }),
    );
    return { event, cycle, venue, speakers };
  }),
);
---

<html lang="it">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>La Miniera Culturale in Periferia</title>
  </head>
  <body>
    <main style="padding: var(--space-7) var(--gutter-page); max-width: var(--max-page); margin: 0 auto;">
      <h1>Verifica della catena</h1>
      <p style="color: var(--text-secondary);">
        Token, caratteri self-hostati e collection. Nessun pezzo del sito vero.
      </p>

      {
        rows.map(({ event, cycle, venue, speakers }) => (
          <article data-cycle={cycle?.data.number} style="border-top: 4px solid var(--accent); padding: var(--space-5) 0; margin-top: var(--space-5);">
            <span style="font: var(--type-mono); text-transform: uppercase; letter-spacing: var(--tracking-caps); color: var(--accent);">
              #{event.data.number} · Ciclo {cycle?.data.name} · {event.data.format}
            </span>
            <h2 style="margin: var(--space-2) 0;">{event.data.title}</h2>
            <p style="color: var(--text-secondary);">{event.data.description}</p>
            <p style="font: var(--type-mono); color: var(--text-muted);">
              {event.data.date.toISOString()} — {venue?.data.name}, {venue?.data.address}, {venue?.data.city}
            </p>
            <ul style="font: var(--type-small); color: var(--text-secondary);">
              {speakers.map((s) => <li>{s.name} — {s.role}</li>)}
            </ul>
          </article>
        ))
      }
    </main>
  </body>
</html>
